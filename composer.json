{
    "name": "liturgical-calendar/unit-test-interface",
    "description": "Web-based graphical test interface for validating the LiturgicalCalendarAPI",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "*"
    },
    "autoload": {
        "psr-4": {
            "LiturgicalCalendar\\UnitTestInterface\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "lint:fix": "phpcbf || echo 'Lint fixing failed. Please check the linting failures and fix them manually.'",
        "lint:md": "npx --yes markdownlint-cli2@0.23.2 \"**/*.md\" \"#node_modules\" \"#vendor\" \"#.superpowers\" \"#.serena.local.bak\" \"#test-results\" \"#playwright-report\"",
        "lint:md:fix": "npx --yes markdownlint-cli2@0.23.2 --fix \"**/*.md\" \"#node_modules\" \"#vendor\" \"#.superpowers\" \"#.serena.local.bak\" \"#test-results\" \"#playwright-report\""
    },
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "John R. D'Orazio",
            "email": "priest@johnromanodorazio.com"
        }
    ],
    "minimum-stability": "stable"
}
