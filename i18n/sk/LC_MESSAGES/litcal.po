msgid "Run complete. Log in to save it to Past Runs."
msgstr ""
"Spustenie dokončené. Prihlás sa na uloženie do Predchádzajúcich spustení."

#: index.php:74 resources.php:74
msgid "Run complete. You do not have permission to save it to Past Runs."
msgstr ""
"Spustenie dokončené. Nemáš oprávnenie uložiť to do Predchádzajúcich spustení."

#: index.php:82 resources.php:82
msgid "Could not load run results."
msgstr "Nepodarilo sa načítať výsledky spustenia."

#: index.php:90 resources.php:90
msgid "Could not load the calendar controls."
msgstr "Nemožno načítať ovládacie prvky kalendára."

#: index.php:101 resources.php:101
msgid ""
"Could not load the list of checks from the API, so no test run can be "
"started. Try reloading the page."
msgstr ""
"Nepodarilo sa načítať zoznam kontrol z rozhrania API, preto nie je možné "
"spustiť test. Skús obnoviť stránku."

